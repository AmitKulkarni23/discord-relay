{
  "name": "discord-relay",
  "private": true,
  "type": "module",
  "engines": {
    "bun": "1.4.2"
  },
  "scripts": {
    "dev": "bun --hot backend/server.ts",
    "start": "bun run backend/server.ts",
    "format": "prettier --write \"{backend,frontend,load,.railway}/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"{backend,frontend,load,.railway}/**/*.{ts,tsx}\"",
    "lint": "eslint frontend",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "devDependencies": {
    "@babel/core": "^8.1.0",
    "@babel/eslint-parser": "^8.0.7",
    "@happy-dom/global-registrator": "^21.0.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "happy-dom": "^21.0.4",
    "prettier": "3.9.10",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^9.5.0",
    "discord.js": "^14.28.0",
    "railway": "^3.16.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
